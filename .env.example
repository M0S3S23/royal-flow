# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=RoyalFlow"
# Database name used for the website
MONGODB_DB="royalflow"
# Long random string used to sign admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Public URL of the site (used for share links, sitemap and social previews)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
